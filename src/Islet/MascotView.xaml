<UserControl x:Class="Islet.MascotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="24" Background="Transparent" Cursor="Hand"
             ToolTip="Blip — poke me">
    <!--
      Blip: a tiny robot drawn from shapes (no image assets). Body takes the accent colour, so it
      matches the album art. The face is swapped per mood; the eyes follow the real cursor.
    -->
    <Canvas Width="28" Height="24">
        <Canvas x:Name="Root" Width="28" Height="24" RenderTransformOrigin="0.5,1">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Squash"/>
                    <RotateTransform x:Name="Tilt"/>
                    <TranslateTransform x:Name="Hop"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- antenna -->
            <Line X1="14" Y1="5" X2="14" Y2="1.5" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
            <Ellipse x:Name="Bulb" Width="4.5" Height="4.5" Canvas.Left="11.75" Canvas.Top="-1.5" Fill="{DynamicResource Accent}"/>

            <!-- body + face plate -->
            <Border Width="28" Height="19" Canvas.Top="5" CornerRadius="10,10,8,8" Background="{DynamicResource Accent}"/>
            <Border Width="22" Height="12.5" Canvas.Left="3" Canvas.Top="8.5" CornerRadius="6.25" Background="#F0101014"/>

            <!-- open eyes (move with gaze, squash to blink) -->
            <Canvas x:Name="OpenEyes">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Lids" CenterX="14" CenterY="14.5"/>
                        <TranslateTransform x:Name="Gaze"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Rectangle Width="4.2" Height="6" RadiusX="2.1" RadiusY="2.1" Canvas.Left="8" Canvas.Top="11.5" Fill="White"/>
                <Rectangle Width="4.2" Height="6" RadiusX="2.1" RadiusY="2.1" Canvas.Left="15.8" Canvas.Top="11.5" Fill="White"/>
            </Canvas>

            <!-- happy ^ ^ -->
            <Path x:Name="HappyEyes" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Visibility="Collapsed"
                  Data="M 7.6,16 L 10.1,12.8 L 12.6,16 M 15.4,16 L 17.9,12.8 L 20.4,16"/>
            <!-- asleep - - -->
            <Path x:Name="SleepEyes" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="Collapsed" Data="M 8,15 L 12.4,15 M 15.6,15 L 20,15"/>
            <!-- dizzy x x -->
            <Path x:Name="DizzyEyes" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="Collapsed" Data="M 8.2,12.6 L 12,16.4 M 12,12.6 L 8.2,16.4 M 16,12.6 L 19.8,16.4 M 19.8,12.6 L 16,16.4"/>
        </Canvas>

        <TextBlock x:Name="Zzz" Text="z" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Dim}"
                   Canvas.Left="25" Canvas.Top="-5" Opacity="0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="ZzzRise"/></TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="Ask" Text="?" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                   Canvas.Left="26" Canvas.Top="-7" Opacity="0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="AskBob"/></TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</UserControl>
