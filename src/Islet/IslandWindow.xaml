<Window x:Class="Islet.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Islet"
        Title="Islet" Width="700" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Fg}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!--
      A big transparent window pinned to the top of the screen. Fully transparent pixels let clicks
      through, so only the island shape is "solid". The shape (a Path) is rebuilt every frame from
      spring-animated width / height / radius, which is what makes the motion feel liquid.
    -->

    <Grid>
        <!-- The split bubble: when two things are live, the second one pops out beside the island. -->
        <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
              MouseEnter="Island_MouseEnter">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BubbleShift"/>
            </Grid.RenderTransform>
            <Border x:Name="BubbleShape" Background="{DynamicResource IslandBg}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.45" Color="Black"/>
                </Border.Effect>
            </Border>
            <Grid x:Name="BubbleContent" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="BubbleContentScale"/></Grid.RenderTransform>
                <!-- music: album art -->
                <Grid Width="20" Height="20" Visibility="{Binding Secondary, Converter={StaticResource IsVis}, ConverterParameter=Media}">
                    <Ellipse Fill="{DynamicResource Track}"/>
                    <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill">
                        <Image.Clip><EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/></Image.Clip>
                    </Image>
                </Grid>
                <!-- timer: ring -->
                <Grid Width="18" Height="18" Visibility="{Binding Secondary, Converter={StaticResource IsVis}, ConverterParameter=Timer}">
                    <Ellipse Stroke="{DynamicResource Track}" StrokeThickness="2.2"/>
                    <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.2" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                             StrokeDashArray="{Binding RunningTimer.Fraction, Converter={StaticResource Ring}, ConverterParameter='18,2.2'}">
                        <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <!-- call: mic -->
                <TextBlock Text="{Binding MicGlyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{Binding MicBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Secondary, Converter={StaticResource IsVis}, ConverterParameter=Call}"/>
                <!-- download -->
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Secondary, Converter={StaticResource IsVis}, ConverterParameter=Download}"/>
                <!-- agent / activity -->
                <TextBlock Text="&#xE99A;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{Binding CompactAgentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Secondary, Converter={StaticResource IsVis}, ConverterParameter=Agent}"/>
                <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Secondary, Converter={StaticResource IsVis}, ConverterParameter=Activity}"/>
            </Grid>
        </Grid>

        <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
              AllowDrop="True"
              MouseEnter="Island_MouseEnter" MouseWheel="Island_MouseWheel"
              DragEnter="Island_DragEnter" DragOver="Island_DragOver"
              DragLeave="Island_DragLeave" Drop="Island_Drop">

            <Path x:Name="Shape" Fill="{DynamicResource IslandBg}">
                <Path.Effect>
                    <DropShadowEffect x:Name="Glow" BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black"/>
                </Path.Effect>
            </Path>

            <!-- Liquid rim: a coloured line along the lower edge (music, approvals, success / error flashes). -->
            <Path x:Name="Rim" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Opacity="0" IsHitTestVisible="False"/>

            <!-- Beads that drip off the edge on good news (and when rain is coming). -->
            <Canvas x:Name="BeadLayer" IsHitTestVisible="False"/>

            <!-- Content area: sits inside the shape's body and is clipped to it. -->
            <Grid x:Name="ClipHost" HorizontalAlignment="Left" VerticalAlignment="Top">

                <!-- ================= COMPACT PILL ================= -->
                <Grid x:Name="CompactLayer" Margin="10,0,14,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Blip lives on the left of the pill when it's idle or an AI agent is busy -->
                    <local:MascotView x:Name="PillMascot" Mood="{Binding Mood}" VerticalAlignment="Center" Margin="2,1,8,0"
                                      Visibility="{Binding MascotInPill, Converter={StaticResource Vis}}"/>

                    <Grid Grid.Column="1">

                    <!-- Idle: clock in the middle, weather on the right -->
                    <Grid Visibility="{Binding ShowCompactIdle, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Clock}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ClockInPillVisible, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="{Binding WeatherTooltip}"
                                    Visibility="{Binding HasWeather, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding WeatherGlyph}" FontFamily="Segoe UI Symbol" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WeatherText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- AI agent: what Claude / Codex is doing right now -->
                    <Grid Visibility="{Binding ShowCompactAgent, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CompactAgentText}" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="8,0,0,0" Fill="{Binding CompactAgentBrush}" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <!-- Meeting: who you're talking on + call timer + mic state -->
                    <Grid Visibility="{Binding ShowCompactCall, Converter={StaticResource Vis}}" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="{Binding MicBrush}" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Margin="9,0,8,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CallApp, Mode=OneWay}"/><Run Text="  " /><Run Text="{Binding CallDuration, Mode=OneWay}" Foreground="{DynamicResource Dim}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding MicGlyph}" FontFamily="{StaticResource Icons}" FontSize="13"
                                   Foreground="{Binding MicBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Timer: countdown ring + time left -->
                    <Grid Visibility="{Binding ShowCompactTimer, Converter={StaticResource Vis}}" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource Track}" StrokeThickness="2"/>
                            <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                     StrokeDashArray="{Binding RunningTimer.Fraction, Converter={StaticResource Ring}, ConverterParameter='16,2'}">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding RunningTimer.Label}" Margin="9,0,8,0" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding RunningTimer.RemainingText}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Download in progress -->
                    <Grid Visibility="{Binding ShowCompactDownload, Converter={StaticResource Vis}}" Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActiveDownload.Name}" Margin="9,0,8,0" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding ActiveDownload.Detail}" FontSize="11.5" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Now playing: album art left, dancing bars right -->
                    <Grid Visibility="{Binding ShowCompactMedia, Converter={StaticResource Vis}}">
                        <Grid Width="22" Height="22" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource Track}" CornerRadius="6"/>
                            <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill">
                                <Image.Clip><RectangleGeometry Rect="0,0,22,22" RadiusX="6" RadiusY="6"/></Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel x:Name="Equalizer" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="14">
                            <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                    </Grid>

                    <!-- Live Activity: status left, title, percent / elapsed right -->
                    <Grid Visibility="{Binding ShowCompactActivity, Converter={StaticResource Vis}}">
                        <Grid DataContext="{Binding CompactActivity}" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="14" Height="14" Stroke="{Binding AccentBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 7,1 A 6,6 0 1 1 1,7" RenderTransformOrigin="0.5,0.5"
                                  Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                                <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                            <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource Icons}" FontSize="13"
                                       Foreground="{Binding AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding IsDone, Converter={StaticResource Vis}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,8,0" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="12" Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    </Grid>

                    <!-- Privacy dots (orange = mic, green = camera, blue = location) -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding PrivacyUses}" VerticalAlignment="Center"
                                  Visibility="{Binding Settings.ShowPrivacy, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="7" Height="7" Margin="7,0,0,0" Fill="{Binding Accent}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ================= PEEK ================= -->
                <Grid x:Name="PeekLayer" Opacity="0" IsHitTestVisible="False" Margin="14,10,20,10" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44">
                        <Border CornerRadius="22" Background="{DynamicResource Card}"/>
                        <TextBlock x:Name="PeekGlyph" FontFamily="{StaticResource Icons}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PeekImage" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="11" RadiusY="11"/></Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekSubtitle" FontSize="12" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>
                        <Grid x:Name="PeekBar" Height="4" Margin="0,6,0,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource Track}" CornerRadius="2"/>
                            <Border Background="{DynamicResource Accent}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="PeekBarScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ================= EXPANDED ================= -->
                <!-- A Canvas gives the panel unlimited room, so ExpandedPanel.ActualHeight is its natural height. -->
                <Canvas x:Name="ExpandedLayer" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                    <Canvas.RenderTransform><ScaleTransform/></Canvas.RenderTransform>
                    <StackPanel x:Name="ExpandedPanel" Canvas.Left="16" Canvas.Top="12" Width="448"
                                SizeChanged="ExpandedPanel_SizeChanged">

                        <!-- Header: tabs on the left, clock / battery / pin / settings on the right -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:MascotView x:Name="HeaderMascot" Mood="{Binding Mood}" VerticalAlignment="Center" Margin="4,2,10,0"
                                                  Visibility="{Binding Settings.ShowMascot, Converter={StaticResource Vis}}"/>
                                <RadioButton Style="{StaticResource TabPill}" Content="&#xE80F;" Tag="Home" GroupName="IslandTabs"
                                             IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=Home}"
                                             Visibility="{Binding TabsVisible, Converter={StaticResource Vis}}"/>
                                <RadioButton Style="{StaticResource TabPill}" Content="&#xE8B7;" Tag="Shelf" GroupName="IslandTabs"
                                             IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=Shelf}"
                                             Visibility="{Binding Settings.ShowShelf, Converter={StaticResource Vis}}"/>
                                <RadioButton Style="{StaticResource TabPill}" Content="&#xE77F;" Tag="Clipboard" GroupName="IslandTabs"
                                             IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter=Clipboard}"
                                             Visibility="{Binding Settings.ShowClipboard, Converter={StaticResource Vis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding TabsVisible, Converter={StaticResource NotVis}}">
                                    <TextBlock Text="{Binding Clock}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource Dim}" Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding WeatherTooltip}"
                                            Visibility="{Binding HasWeather, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding WeatherGlyph}" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="{DynamicResource Dim}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding WeatherText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Dim}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Clock}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Dim}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding DateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Settings.ShowClock}" Value="True"/>
                                                        <Condition Binding="{Binding TabsVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding BatteryText}" FontSize="12" Foreground="{DynamicResource Dim}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding BatteryVisible, Converter={StaticResource Vis}}"/>
                                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" FontSize="14"
                                        Opacity="0.55" ToolTip="Keep open (Ctrl+Alt+I)" Click="Pin_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14"
                                        ToolTip="Settings" Command="{Binding OpenSettingsCommand}"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="TabHost" Margin="0,12,0,4">

                            <!-- ===== HOME ===== -->
                            <StackPanel x:Name="HomePanel">
                                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>

                                <!-- First run: a friendly hello that teaches the three things worth knowing -->
                                <Grid Margin="0,0,0,10" Visibility="{Binding ShowWelcome, Converter={StaticResource Vis}}">
                                    <Border Background="{DynamicResource Card}" CornerRadius="20"/>
                                    <Border Background="{DynamicResource AccentWash}" CornerRadius="20"/>
                                    <StackPanel Margin="16,14">
                                        <TextBlock Text="Welcome to Islet" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19">
                                            Hover the island to open it. Scroll on it for volume, drop files on it to park them.
                                            <LineBreak/>Ctrl+Alt+I keeps it open · Ctrl+Alt+M mutes your mic anywhere.
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Got it" Command="{Binding DismissWelcomeCommand}" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource SoftButton}" Content="Make it mine" Command="{Binding OpenSettingsCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Quick actions: the things you reach for many times a day -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{Binding MicGlyph}" Tag="{Binding MicLabel}" Command="{Binding ToggleMicCommand}"
                                            ToolTip="Mute / unmute your microphone everywhere (Ctrl+Alt+M)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Tile}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                                        <Setter Property="Background" Value="#40FF453A"/>
                                                        <Setter Property="Foreground" Value="#FF6B63"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource Tile}" Content="&#xE916;" Tag="Timer"
                                            Command="{Binding ToggleTimerPickerCommand}" ToolTip="Start a timer"/>
                                    <Button Grid.Column="2" Style="{StaticResource Tile}" Content="&#xE8C6;" Tag="Snip"
                                            Command="{Binding SnipCommand}" ToolTip="Screenshot an area (like Win+Shift+S)"/>
                                    <Button Grid.Column="3" Style="{StaticResource Tile}" Content="&#xE896;" Tag="Downloads" Margin="0"
                                            Command="{Binding OpenDownloadsCommand}" ToolTip="Open your Downloads folder"/>
                                </Grid>

                                <!-- Timer presets (shown after tapping Timer); scroll the last chip to pick any length -->
                                <WrapPanel Margin="0,0,0,6" Visibility="{Binding TimerPickerOpen, Converter={StaticResource Vis}}">
                                    <Button Style="{StaticResource Chip}" Content="1 min" Command="{Binding StartTimerCommand}" CommandParameter="1"/>
                                    <Button Style="{StaticResource Chip}" Content="5 min" Command="{Binding StartTimerCommand}" CommandParameter="5"/>
                                    <Button Style="{StaticResource Chip}" Content="10 min" Command="{Binding StartTimerCommand}" CommandParameter="10"/>
                                    <Button Style="{StaticResource Chip}" Content="15 min" Command="{Binding StartTimerCommand}" CommandParameter="15"/>
                                    <Button Style="{StaticResource Chip}" Content="Focus 25" Command="{Binding StartTimerCommand}" CommandParameter="25"/>
                                    <Button Style="{StaticResource Chip}" Content="45 min" Command="{Binding StartTimerCommand}" CommandParameter="45"/>
                                    <Button Style="{StaticResource Chip}" Command="{Binding CustomTimerCommand}" MouseWheel="CustomTimer_Wheel"
                                            ToolTip="Scroll to change, click to start">
                                        <TextBlock>
                                            <Run Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="11"/><Run Text=" "/><Run Text="{Binding CustomLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button>
                                </WrapPanel>

                                <!-- Timers -->
                                <ItemsControl ItemsSource="{Binding Timers}" Visibility="{Binding Settings.ShowTimers, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="18" Padding="12,10,8,10" Margin="0,0,0,8" Background="{DynamicResource Card}" BorderThickness="1.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FF9F0A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="40" Height="40">
                                                        <Ellipse Stroke="{DynamicResource Track}" StrokeThickness="3.5"/>
                                                        <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="3.5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                                                 StrokeDashArray="{Binding Fraction, Converter={StaticResource Ring}, ConverterParameter='40,3.5'}">
                                                            <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="14" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Dim}"/>
                                                        <TextBlock Text="{Binding RemainingText}" FontSize="20" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <!-- running / paused -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsDone, Converter={StaticResource NotVis}}">
                                                        <Button Style="{StaticResource IconButton}" Content="{Binding PauseGlyph}" ToolTip="Pause / resume"
                                                                Command="{Binding DataContext.TimerPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Content="+1" ToolTip="Add a minute"
                                                                Command="{Binding DataContext.TimerAddCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" ToolTip="Cancel"
                                                                Command="{Binding DataContext.TimerRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                    <!-- time's up -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsDone, Converter={StaticResource Vis}}">
                                                        <Button Style="{StaticResource SoftButton}" Content="+5 min" Margin="0,0,8,0"
                                                                Command="{Binding DataContext.TimerAddCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Done"
                                                                Command="{Binding DataContext.TimerRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Meeting mode: call timer + one big mute button -->
                                <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="14,10,10,10" Margin="0,0,0,8"
                                        Visibility="{Binding InCall, Converter={StaticResource Vis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding MicBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <Run Text="In a call · "/><Run Text="{Binding CallApp, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="16,3,0,0">
                                                <TextBlock Text="{Binding CallDuration}" FontSize="12" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="  ·  camera on" FontSize="12" Foreground="#30D158"
                                                           Visibility="{Binding CameraOn, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="  ·  you're muted" FontSize="12" Foreground="#FF6B63"
                                                           Visibility="{Binding MicMuted, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource RoundAction}" Content="{Binding MicGlyph}" Background="{Binding MicBrush}"
                                                Command="{Binding ToggleMicCommand}" ToolTip="Mute / unmute (Ctrl+Alt+M)"/>
                                    </Grid>
                                </Border>

                                <!-- Downloads: live progress, then open / show / drag anywhere -->
                                <ItemsControl ItemsSource="{Binding Downloads.Items}" Visibility="{Binding Settings.ShowDownloads, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource HoverCard}" CornerRadius="16" Padding="10,8,6,8" Margin="0,0,0,8" Tag="{Binding}"
                                                    Cursor="Hand" ToolTip="Drag me into an email, chat or folder"
                                                    PreviewMouseLeftButtonDown="Download_MouseDown" MouseMove="Download_MouseMove">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="36" Height="36">
                                                        <Border CornerRadius="10" Background="{DynamicResource Card}"/>
                                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                                                        <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"
                                                               Visibility="{Binding IsDone, Converter={StaticResource Vis}}"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Dim}">
                                                            <Run Text="{Binding Detail, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" FontSize="13" ToolTip="Open"
                                                                Visibility="{Binding IsDone, Converter={StaticResource Vis}}"
                                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" FontSize="13" ToolTip="Show in folder"
                                                                Visibility="{Binding IsDone, Converter={StaticResource Vis}}"
                                                                Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE718;" FontSize="13" ToolTip="Keep on the shelf"
                                                                Visibility="{Binding IsDone, Converter={StaticResource Vis}}"
                                                                Command="{Binding DataContext.ShelveDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Width="26" Height="26" ToolTip="Dismiss"
                                                                Command="{Binding DataContext.DismissDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- AI agent approvals: Allow / Deny without hunting for the terminal -->
                                <ItemsControl ItemsSource="{Binding Agents.Approvals}"
                                              Visibility="{Binding Settings.ShowAgents, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="14,12" Margin="0,0,0,8"
                                                    BorderBrush="#FF9F0A" BorderThickness="1.5">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF9F0A" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RemainingText}" FontSize="11.5" Foreground="{DynamicResource Faint}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="After this, the terminal asks as usual"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Where}" FontSize="11.5" Foreground="{DynamicResource Dim}" Margin="23,1,0,0"/>
                                                    <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="10,8" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Detail}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                   TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                        <Button Style="{StaticResource LinkButton}" Content="Ask in terminal" Tag="ask" Click="Approval_Click"
                                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource SoftButton}" Content="Deny" Tag="deny" Click="Approval_Click" Margin="0,0,8,0"/>
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Allow" Tag="allow" Click="Approval_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- AI agent sessions: status, current step, recent steps, latest answer -->
                                <ItemsControl ItemsSource="{Binding Agents.Sessions}"
                                              Visibility="{Binding Settings.ShowAgents, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="14,11,8,12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="9,0,8,0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" FontSize="11.5" VerticalAlignment="Center" Foreground="{Binding StatusBrush}">
                                                            <Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text=" · " Foreground="{DynamicResource Faint}"/><Run Text="{Binding ElapsedText, Mode=OneWay}" Foreground="{DynamicResource Dim}"/>
                                                        </TextBlock>
                                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                                                                Width="24" Height="24" Margin="4,0,0,0" ToolTip="Dismiss"
                                                                Command="{Binding DataContext.DismissAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Prompt, StringFormat='“{0}”'}" FontSize="11.5" FontStyle="Italic"
                                                               Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis" Margin="17,3,8,0"
                                                               Visibility="{Binding HasPrompt, Converter={StaticResource Vis}}"/>
                                                    <TextBlock Text="{Binding Action}" FontSize="12.5" Margin="17,6,8,0" TextTrimming="CharacterEllipsis"/>
                                                    <ItemsControl ItemsSource="{Binding History}" Margin="17,2,8,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat='✓ {0}'}" FontSize="11.5" Foreground="{DynamicResource Faint}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="10,7" Margin="17,8,8,0"
                                                            Visibility="{Binding HasAnswer, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Answer}" FontSize="12" TextWrapping="Wrap" MaxHeight="64"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Privacy chips: who is using the mic / camera right now -->
                                <ItemsControl ItemsSource="{Binding PrivacyUses}"
                                              Visibility="{Binding Settings.ShowPrivacy, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Card}" CornerRadius="99" Padding="10,5" Margin="0,0,6,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AppName}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource Dim}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                        <Run Text="· "/><Run Text="{Binding CapabilityLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Now playing card, tinted by the album colour -->
                                <Grid Margin="0,0,0,8" Visibility="{Binding MediaCardVisible, Converter={StaticResource Vis}}">
                                    <Border Background="{DynamicResource Card}" CornerRadius="20"/>
                                    <Border Background="{DynamicResource AccentWash}" CornerRadius="20"/>
                                    <StackPanel Margin="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="84" Height="84" VerticalAlignment="Top">
                                                <Border Background="{DynamicResource Track}" CornerRadius="14">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="26"
                                                               Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill">
                                                    <Image.Clip><RectangleGeometry Rect="0,0,84,84" RadiusX="14" RadiusY="14"/></Image.Clip>
                                                </Image>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Media.Source}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource LinkButton}" Margin="6,0,0,0" ToolTip="Switch player"
                                                            Command="{Binding SwitchPlayerCommand}"
                                                            Visibility="{Binding Media.CanSwitchPlayer, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="11"/>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Media.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding Media.Artist}" FontSize="13" Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Visibility="{Binding Media.HasTimeline, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                                                    <Grid x:Name="SeekBar" Height="14" Background="Transparent" Cursor="Hand"
                                                          MouseLeftButtonUp="SeekBar_Click" ToolTip="Click to seek">
                                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Track}"/>
                                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding Media.Progress, Mode=OneWay}"/></Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Media.PositionText}" FontSize="11" Foreground="{DynamicResource Dim}"/>
                                                        <TextBlock Text="{Binding Media.RemainingText}" FontSize="11" Foreground="{DynamicResource Dim}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Synced lyrics (LRCLIB) -->
                                        <StackPanel Margin="4,12,4,0" Visibility="{Binding LyricsVisible, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Media.Lyric, NotifyOnTargetUpdated=True}" FontSize="15" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextWrapping="Wrap">
                                                <TextBlock.Triggers>
                                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.4"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </TextBlock.Triggers>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Media.NextLyric}" FontSize="12.5" Foreground="{DynamicResource Faint}"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Transport controls -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="14" Margin="0,0,10,0"
                                                    ToolTip="Shuffle" Command="{Binding ShuffleCommand}" Opacity="{Binding Media.ShuffleOpacity}"
                                                    Visibility="{Binding Media.CanShuffle, Converter={StaticResource Vis}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="17" Width="40" Height="40"
                                                    Command="{Binding PreviousCommand}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource PlayButton}" Content="{Binding Media.PlayPauseGlyph}" Margin="12,0"
                                                    Command="{Binding PlayPauseCommand}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="17" Width="40" Height="40"
                                                    Command="{Binding NextCommand}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconButton}" Content="{Binding Media.RepeatGlyph}" FontSize="14" Margin="10,0,0,0"
                                                    ToolTip="Repeat" Command="{Binding RepeatCommand}" Opacity="{Binding Media.RepeatOpacity}"
                                                    Visibility="{Binding Media.CanRepeat, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Nothing playing: offer to open Spotify -->
                                <Border Background="{DynamicResource Card}" CornerRadius="20" Padding="14" Margin="0,0,0,8"
                                        Visibility="{Binding MediaEmptyVisible, Converter={StaticResource Vis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Track}">
                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="18"
                                                       Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Nothing playing" FontWeight="SemiBold"/>
                                            <TextBlock Text="Spotify, YouTube and any media app show up here" FontSize="11.5"
                                                       Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Open Spotify"
                                                VerticalAlignment="Center" Command="{Binding OpenSpotifyCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- Volume -->
                                <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="6,4,14,4" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Settings.ShowMedia}" Value="True"/>
                                                        <Condition Binding="{Binding VolumeKnown}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" FontSize="15"
                                                ToolTip="Mute" Command="{Binding ToggleMuteCommand}"/>
                                        <Slider Grid.Column="1" Style="{StaticResource IsletSlider}" Minimum="0" Maximum="1"
                                                Value="{Binding Volume}" Margin="6,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="12" Foreground="{DynamicResource Dim}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Live Activities -->
                                <ItemsControl ItemsSource="{Binding Activities}"
                                              Visibility="{Binding Settings.ShowActivities, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="12,10,6,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Path Width="14" Height="14" Stroke="{Binding AccentBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 7,1 A 6,6 0 1 1 1,7" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center"
                                                          Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                                                        <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                                        <Path.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Path.Triggers>
                                                    </Path>
                                                    <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource Icons}" FontSize="14"
                                                               Foreground="{Binding AccentBrush}" VerticalAlignment="Center"
                                                               Visibility="{Binding IsDone, Converter={StaticResource Vis}}"/>

                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource Dim}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="12"
                                                               Foreground="{Binding AccentBrush}" VerticalAlignment="Center"/>

                                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;"
                                                            FontSize="9" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Dismiss"
                                                            Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,8,0,0"
                                                          Visibility="{Binding HasProgress, Converter={StaticResource Vis}}">
                                                        <Border Background="{DynamicResource Track}" CornerRadius="2"/>
                                                        <Border Background="{Binding AccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding ProgressFraction}"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ===== SHELF ===== -->
                            <StackPanel x:Name="ShelfPanel" Visibility="Collapsed">
                                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                                <Grid Margin="2,0,0,8">
                                    <TextBlock Text="Drag files out anywhere · double-click opens · right-click removes"
                                               FontSize="11.5" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Clear" HorizontalAlignment="Right"
                                            Command="{Binding ClearShelfCommand}"
                                            Visibility="{Binding HasShelfItems, Converter={StaticResource Vis}}"/>
                                </Grid>
                                <Grid Height="130" Visibility="{Binding ShelfEmpty, Converter={StaticResource Vis}}">
                                    <Rectangle x:Name="ShelfDropRect" RadiusX="18" RadiusY="18" StrokeThickness="1.5"
                                               StrokeDashArray="4 3" Stroke="{DynamicResource Track}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="22" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Dim}"/>
                                        <TextBlock x:Name="ShelfHint" Text="Drop files on the island" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                        <TextBlock Text="Park them here and drag them out later" FontSize="12"
                                                   Foreground="{DynamicResource Dim}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="ShelfCard" CornerRadius="18" BorderThickness="1.5" BorderBrush="Transparent"
                                        Background="{DynamicResource Card}" Padding="8"
                                        Visibility="{Binding HasShelfItems, Converter={StaticResource Vis}}">
                                    <ItemsControl ItemsSource="{Binding Shelf}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="85" Padding="4,8" CornerRadius="12" Tag="{Binding}" Cursor="Hand"
                                                        ToolTip="{Binding Path}"
                                                        PreviewMouseLeftButtonDown="ShelfItem_MouseDown"
                                                        MouseMove="ShelfItem_MouseMove"
                                                        MouseRightButtonUp="ShelfItem_RightClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource CardHover}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Image Source="{Binding Icon}" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,5,0,0"
                                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- ===== CLIPBOARD ===== -->
                            <StackPanel x:Name="ClipPanel" Visibility="Collapsed">
                                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                                <Grid Margin="2,0,0,8">
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                               Text="Click to paste into the app you were typing in"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Clear" HorizontalAlignment="Right"
                                            Command="{Binding ClearClipsCommand}"/>
                                </Grid>
                                <Grid Height="130" Visibility="{Binding ClipsEmpty, Converter={StaticResource Vis}}">
                                    <Rectangle RadiusX="18" RadiusY="18" StrokeThickness="1.5" StrokeDashArray="4 3" Stroke="{DynamicResource Track}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="22" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Dim}"/>
                                        <TextBlock Text="History is empty" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                        <TextBlock Text="Copy text or an image and it shows up here" FontSize="12"
                                                   Foreground="{DynamicResource Dim}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Clips}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverCard}" CornerRadius="14" Padding="12,9,6,9" Margin="0,0,0,6"
                                                        Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="Clip_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Preview}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="36"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                                                            <Image Source="{Binding Thumbnail}" MaxHeight="72" HorizontalAlignment="Left" Stretch="Uniform"
                                                                   Visibility="{Binding IsImage, Converter={StaticResource Vis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Faint}"
                                                                   Margin="10,2,4,0" VerticalAlignment="Top"/>
                                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE718;" FontSize="12"
                                                                Width="26" Height="26" VerticalAlignment="Top" ToolTip="Pin"
                                                                Opacity="{Binding PinOpacity}"
                                                                Command="{Binding DataContext.PinClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</Window>
